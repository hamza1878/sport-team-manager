{% extends 'base.html.twig' %}

{% block title %}Compte créé avec succès{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5 text-center">
                    <div class="mb-4">
                        <span style="font-size: 5rem;">✅</span>
                    </div>
                    
                    <h1 class="display-4 text-success mb-4">Compte créé avec succès !</h1>
                    
                    <div class="alert alert-info text-start">
                        <h4 class="alert-heading">
                            <i class="bi bi-person-circle"></i> {{ name }}
                        </h4>
                        <hr>
                        <p class="mb-2">
                            <strong>📧 Email :</strong> 
                            <code>{{ email }}</code>
                        </p>
                        <p class="mb-2">
                            <strong>💼 Fonction :</strong> 
                            {{ role }}
                        </p>
                    </div>
                    
                    <div class="alert alert-warning text-start">
                        <h5 class="alert-heading">
                            <i class="bi bi-key-fill"></i> Identifiants envoyés
                        </h5>
                        <p class="mb-2">
                            <strong>Mot de passe temporaire :</strong>
                            <code class="fs-5">{{ password }}</code>
                        </p>
                        <hr>
                        <p class="mb-0 small text-muted">
                            ✉️ Un email avec les identifiants complets a été envoyé à <strong>{{ email }}</strong>
                        </p>
                    </div>
                    
                    <div class="alert alert-success text-start">
                        <p class="mb-0">
                            <i class="bi bi-check-circle-fill"></i>
                            Le coach peut maintenant se connecter avec ses identifiants ou via le lien dans l'email (valide 24h).
                        </p>
                    </div>
                    
                    <div class="mt-4">
                        <a href="{{ path('app_login') }}" class="btn btn-primary btn-lg">
                            <i class="bi bi-arrow-left"></i> Retour à l'accueil
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 15px;
        overflow: hidden;
    }
    
    code {
        background: #f8f9fa;
        padding: 4px 8px;
        border-radius: 4px;
        color: #d63384;
    }
    
    .alert {
        border-radius: 10px;
    }
</style>
{% endblock %}